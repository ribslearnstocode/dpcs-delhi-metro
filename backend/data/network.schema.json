{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Delhi NCR Metro Network",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "sample",
        "documented",
        "verified"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "stations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Station"
      },
      "minItems": 1
    },
    "lines": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/MetroLine"
      },
      "minItems": 1
    },
    "connections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Connection"
      }
    },
    "transfers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/TransferEdge"
      }
    }
  },
  "required": [
    "version",
    "kind",
    "description",
    "stations",
    "lines",
    "connections",
    "transfers"
  ],
  "additionalProperties": false,
  "$defs": {
    "Station": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "status": {
          "enum": [
            "operational",
            "access-unconfirmed"
          ]
        },
        "lineIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "labelDx": {
          "type": "number"
        },
        "labelDy": {
          "type": "number"
        }
      },
      "required": [
        "id",
        "name",
        "code",
        "lineIds",
        "x",
        "y",
        "labelDx",
        "labelDy"
      ],
      "additionalProperties": false
    },
    "MetroLine": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "stationIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            }
          }
        }
      },
      "required": [
        "id",
        "name",
        "color",
        "stationIds"
      ],
      "additionalProperties": false
    },
    "Connection": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "from": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "to": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "lineId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "minutes": {
          "type": "number",
          "minimum": 0
        },
        "bidirectional": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "from",
        "to",
        "lineId",
        "minutes"
      ],
      "additionalProperties": false
    },
    "TransferEdge": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "stationId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "toStationId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "fromLineId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "toLineId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "minutes": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "id",
        "stationId",
        "fromLineId",
        "toLineId",
        "minutes"
      ],
      "additionalProperties": false
    }
  }
}
